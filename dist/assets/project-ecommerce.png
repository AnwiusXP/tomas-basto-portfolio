<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b1329" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>
    <linearGradient id="glow" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#10b981" stop-opacity="0.6" />
      <stop offset="100%" stop-color="#06b6d4" stop-opacity="0.6" />
    </linearGradient>
    <linearGradient id="cardGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" stop-opacity="0.8" />
      <stop offset="100%" stop-color="#0f172a" stop-opacity="0.9" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="800" height="450" fill="url(#bg)" />
  
  <!-- Subtle Grid -->
  <g stroke="#334155" stroke-width="0.5" stroke-opacity="0.25">
    <path d="M0,75 H800 M0,150 H800 M0,225 H800 M0,300 H800 M0,375 H800" />
    <path d="M100,0 V450 M200,0 V450 M300,0 V450 M400,0 V450 M500,0 V450 M600,0 V450 M700,0 V450" />
  </g>

  <!-- Glow orb -->
  <circle cx="400" cy="200" r="180" fill="#10b981" fill-opacity="0.08" filter="blur(40px)" />

  <!-- Mock Dashboard Card -->
  <rect x="120" y="70" width="560" height="310" rx="16" fill="url(#cardGlow)" stroke="#334155" stroke-width="1.5" />
  
  <!-- Dashboard Top Bar -->
  <rect x="120" y="70" width="560" height="40" rx="16" fill="#0f172a" stroke="#334155" stroke-width="1" />
  <circle cx="145" cy="90" r="5" fill="#ef4444" />
  <circle cx="160" cy="90" r="5" fill="#f59e0b" />
  <circle cx="175" cy="90" r="5" fill="#10b981" />
  <text x="400" y="95" fill="#94a3b8" font-size="12" font-family="sans-serif" text-anchor="middle" font-weight="600">elan-pure-dashboard.platform.app</text>

  <!-- Metric Widget 1 -->
  <rect x="150" y="130" width="150" height="85" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1" />
  <text x="165" y="155" fill="#94a3b8" font-size="11" font-family="sans-serif">Live Inventory AI</text>
  <text x="165" y="185" fill="#34d399" font-size="20" font-weight="bold" font-family="sans-serif">+99.8% Sync</text>

  <!-- Metric Widget 2 -->
  <rect x="325" y="130" width="150" height="85" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1" />
  <text x="340" y="155" fill="#94a3b8" font-size="11" font-family="sans-serif">AI Demand Forecast</text>
  <text x="340" y="185" fill="#38bdf8" font-size="20" font-weight="bold" font-family="sans-serif">High Accuracy</text>

  <!-- Metric Widget 3 -->
  <rect x="500" y="130" width="150" height="85" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1" />
  <text x="515" y="155" fill="#94a3b8" font-size="11" font-family="sans-serif">Render Uptime</text>
  <text x="515" y="185" fill="#a855f7" font-size="20" font-weight="bold" font-family="sans-serif">99.9% Active</text>

  <!-- Mock Chart -->
  <rect x="150" y="235" width="500" height="120" rx="10" fill="#0f172a" stroke="#1e293b" stroke-width="1" />
  <path d="M 170 320 Q 230 280, 290 290 T 410 260 T 530 275 T 630 245" fill="none" stroke="url(#glow)" stroke-width="3" />
  <circle cx="630" cy="245" r="5" fill="#06b6d4" />
</svg>
