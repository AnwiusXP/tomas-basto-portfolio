<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgMob" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#080e1a" />
      <stop offset="100%" stop-color="#020617" />
    </linearGradient>
    <linearGradient id="glowMob" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#3b82f6" />
    </linearGradient>
  </defs>

  <rect width="800" height="450" fill="url(#bgMob)" />

  <!-- Left: Mobile Device Frame -->
  <g transform="translate(180, 45)">
    <rect width="180" height="360" rx="28" fill="#0f172a" stroke="#334155" stroke-width="3" />
    <!-- Screen Notch -->
    <rect x="55" y="10" width="70" height="12" rx="6" fill="#1e293b" />
    <!-- Screen Content -->
    <rect x="15" y="35" width="150" height="305" rx="14" fill="#020617" />
    <!-- Header inside screen -->
    <rect x="25" y="50" width="80" height="10" rx="4" fill="#06b6d4" />
    <!-- Card inside screen -->
    <rect x="25" y="75" width="130" height="60" rx="8" fill="#1e293b" />
    <rect x="25" y="145" width="130" height="85" rx="8" fill="#1e293b" />
    <rect x="25" y="240" width="130" height="45" rx="8" fill="#1e293b" />
  </g>

  <!-- Connection Data Stream -->
  <path d="M 370 225 L 450 225" fill="none" stroke="url(#glowMob)" stroke-width="3" stroke-dasharray="6,4" />
  <polygon points="455,225 445,220 445,230" fill="#38bdf8" />

  <!-- Right: Node.js Middleware & Cloud Architecture -->
  <g transform="translate(460, 95)">
    <rect width="220" height="260" rx="16" fill="#0f172a" stroke="#334155" stroke-width="1.5" />
    <rect x="0" y="0" width="220" height="40" rx="16" fill="#1e293b" />
    <text x="110" y="25" fill="#38bdf8" font-size="12" font-family="monospace" text-anchor="middle" font-weight="bold">NODE.JS MIDDLEWARE</text>
    
    <!-- Middleware Components -->
    <rect x="20" y="55" width="180" height="45" rx="8" fill="#020617" stroke="#334155" stroke-width="1" />
    <text x="35" y="82" fill="#94a3b8" font-size="11" font-family="sans-serif">Express REST Handler</text>
    
    <rect x="20" y="115" width="180" height="45" rx="8" fill="#020617" stroke="#334155" stroke-width="1" />
    <text x="35" y="142" fill="#34d399" font-size="11" font-family="sans-serif">Firebase NoSQL Sync</text>
    
    <rect x="20" y="175" width="180" height="45" rx="8" fill="#020617" stroke="#334155" stroke-width="1" />
    <text x="35" y="202" fill="#a855f7" font-size="11" font-family="sans-serif">Render Cloud Hosting</text>
  </g>
</svg>
